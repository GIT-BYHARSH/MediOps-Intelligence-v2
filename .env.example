# Copy this file to .env and fill in your own values. NEVER commit .env (it is in .gitignore).

# --- Database (already used by the project) ---
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediops

# --- Optional: AI features (python/llm.py). Without these the project uses templates. ---
# Any OpenAI-compatible provider works. Check your provider's docs for the exact base URL and model name.
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL defaults to https://api.openai.com/v1. Examples of other providers:
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Groq          : https://api.groq.com/openai/v1
#   OpenRouter    : https://openrouter.ai/api/v1
#   Ollama (local): http://localhost:11434/v1   (key can be any text)
# LLM_BASE_URL=

# --- Optional: put the demo online (see docs/deploy.md) ---
# Only needed on your laptop to copy the data to a free cloud database (python/export_to_cloud.py).
# CLOUD_DATABASE_URL=postgresql://owner:password@host/dbname?sslmode=require
# The export script then saves CLOUD_READER_URL here (a read-only user). In the deployed app's
# secrets it is stored under the name DATABASE_URL. Never commit either value.
